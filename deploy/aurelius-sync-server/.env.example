# Copy to .env in this same directory before running docker compose up.
# This file documents every setting a self-hosted aurelius-sync-server
# instance needs — nothing else is required to run your own.

# Required. Protects the admin-only POST /sync/grants and
# /sync/grants/revoke endpoints (issuing/revoking collaborator tokens).
# Generate one with: openssl rand -hex 32
AURELIUS_SYNC_ADMIN_TOKEN=

# Optional. Host port to publish the server on. Defaults to 8181.
AURELIUS_SYNC_PORT=8181
