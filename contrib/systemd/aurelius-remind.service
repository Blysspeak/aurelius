# Юнит systemd УРОВНЯ ПОЛЬЗОВАТЕЛЯ (кладётся в ~/.config/systemd/user/, а
# не в /etc/systemd/system/ — тут не нужен root): единственный процесс во
# всей системе, которому разрешено владеть часами напоминаний
# (aurelius:reminders:clock-owner, решение владельца 2026-09-10). MCP-сервер
# поднимается заново на каждую сессию Claude Code, и таймер внутри него
# размножился бы по числу сессий, а не остался одним — поэтому часы живут
# здесь, одной службой, а не в MCP и не в сессии.
#
# Установка и включение — две команды:
#   mkdir -p ~/.config/systemd/user && cp aurelius-remind.service ~/.config/systemd/user/
#   systemctl --user enable --now aurelius-remind.service
#
# Второй экземпляр этого же юнита — случайный `systemctl --user start`
# поверх уже включённого, повторный `enable` после того, как файл скопирован
# дважды, юнит, по ошибке заведённый ещё и как системный, — БЕЗВРЕДЕН, а не
# разрушителен. Одиночность демона держит файловый замок рядом с базой
# (`au daemon`, PID + проверка живости через /proc/<pid>), а не сам факт
# того, что юнит запущен один раз: второй запуск увидит живой PID в замке,
# откажется стартовать отдельным кодом возврата и завершится, не тронув
# базу — супервизор ошибку увидит, а данные целы.
[Unit]
Description=Aurelius — демон напоминаний (единственный владелец часов)

[Service]
Type=simple
ExecStart=%h/.local/bin/au daemon
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
